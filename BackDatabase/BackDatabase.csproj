<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BackDatabase</RootNamespace>
    <AssemblyName>BackDatabase</AssemblyName>
    <Version>3.1.0</Version>

    <!--
      半裁剪策略（体积 vs 第三方反射 JSON 的中间方案）：
      1. PublishTrimmed 由发布配置打开时生效；
      2. 允许 STJ 反射序列化（第三方 HxPushSdk 内部仍用反射 API）；
      3. 对 HxPush* 程序集做 TrimmerRoot，避免类型/属性被裁掉；
      4. 本项目业务 JSON 仍优先走 AppJsonContext 源生成。
    -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- 分析器：本项目若误用反射泛型 API 仍会在编译期提示；不设为错误，避免第三方注解噪音 -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时扫描可执行文件旁的 config/*.conf；样例一并复制到输出目录 -->
    <None Update="config\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 全局 env.conf 样例（运行时读 env.conf，不读 example） -->
    <None Update="env.conf.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="env.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Kestrel 管理界面的静态资源，运行时从 exe 同目录的 web/ 提供 -->
    <None Update="web\**\*.html;web\**\*.css;web\**\*.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- 裁剪时整库保留推送 SDK，内部反射序列化才能扫到元数据 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="HxPushSdk" />
    <TrimmerRootAssembly Include="HxPushModel" />
    <!-- DriveInfo（GetDiskInfo 查硬盘空间用）位于此程序集；
         CreationTimeUtc（ListBackupFiles 用）也位于此程序集。
         PublishTrimmed=true 时会被裁剪器剔掉，Linux 运行时报
         "Could not load System.IO.FileSystem.DriveInfo" / "MissingMethodException CreationTimeUtc"，
         故显式保留 -->
    <TrimmerRootAssembly Include="System.IO.FileSystem.DriveInfo" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="utils\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HxPushModel">
      <HintPath>..\..\HxPush\HxPushSdk\bin\Release\net8.0\HxPushModel.dll</HintPath>
    </Reference>
    <Reference Include="HxPushSdk">
      <HintPath>..\..\HxPush\HxPushSdk\bin\Release\net8.0\HxPushSdk.dll</HintPath>
    </Reference>
    <Reference Include="HxSimpleWebAuth">
      <HintPath>..\..\fc\checkserver\HxSimpleWebAuth\bin\Release\net8.0\HxSimpleWebAuth.dll</HintPath>
    </Reference>
  </ItemGroup>


</Project>
