dbType=mysql # mysql或pgsql  注：mariadb也是填mysql
backtime=2 # 每隔多少分钟进行一次备份；若为数字则按间隔；若为 HH:mm 则每天该 UTC 时间备份
port=3306 #端口
host=127.0.0.1 #服务器地址
dbs=ss,hhx #数据库
user=root #用户
pwd=pwd #密码
savedir=/backup/ #保存路径 相对于程序当前的执行路径 比如 /test/或者/test2/t/
maxfiles=50 # 最大保存的文件数量 默认为180
dbtimes=ss:30,hhx:02:00 # 可选：给单个库指定独立计划，格式 库名:计划，多个用逗号分隔；规则同 backtime（数字=分钟，HH:mm=每天该 UTC 时间）。未列出的库沿用上面的 backtime
